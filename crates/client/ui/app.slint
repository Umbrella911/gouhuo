// SPDX-License-Identifier: GPL-3.0-or-later

import { Theme, Btn, Field, Dot, LevelBar } from "theme.slint";
import { ScrollView, Slider, ComboBox } from "std-widgets.slint";

// 频道树和成员名单压成的一行。
//
// 用一个扁平列表而不是嵌套模型：频道和人本来就是交替出现的，
// 嵌套两层模型换不来任何东西，却要在 Rust 那边维护两套同步逻辑。
export struct Row {
    is-channel: bool,
    id: int,
    name: string,
    depth: int,
    // 下面几个只对人有意义
    muted: bool,
    deafened: bool,
    speaking: bool,
    is-me: bool,
    // 只对频道有意义：我在不在这个频道里
    is-current: bool,
    // 频道里有几个人，显示在右边
    count: int,
}

/// 一次麦克风检测的结果。
export struct ScanRow {
    name: string,
    verdict: string,
    /// 真的收到人声了。
    ok: bool,
    /// WASAPI 的设备 id。
    ///
    /// **带 id 而不是下拉框里的序号**：序号要靠两次列举的顺序一致才对得上，
    /// 对不上就会悄悄选中别的设备 —— 用户点了 A 结果用上了 B，
    /// 而界面上什么都不会说。
    id: string,
}

export struct ChatRow {
    sender: string,
    body: string,
    time: string,
    is-me: bool,
}

export component App inherits Window {
    title: "开麦";
    background: Theme.bg;
    default-font-family: Theme.font;
    min-width: 720px;
    min-height: 480px;
    preferred-width: 900px;
    preferred-height: 620px;

    // ---- 状态 ----
    in-out property <bool> connected: false;
    in-out property <bool> connecting: false;
    in-out property <string> invite-link;
    in-out property <string> nick;
    in property <string> error-headline;
    in property <string> error-advice;

    in property <string> server-name: "开麦";
    in property <string> my-fingerprint;
    in property <[Row]> rows;
    in property <[ChatRow]> chat;
    in-out property <string> draft;
    in-out property <bool> self-muted: false;
    in-out property <bool> self-deafened: false;
    // UDP 通不通。不通的时候要让用户看见，而不是让他纳闷为什么没声音。
    in property <bool> udp-ok: false;
    // 语音那边出的错（设备打不开、采样率不对）。要能直接显示给用户。
    in property <string> voice-error;

    // ---- 设置 ----
    in-out property <bool> show-settings: false;
    in-out property <bool> ptt-mode: false;
    /// 按住说话绑的键，给人看的名字。空表示还没绑。
    in property <string> ptt-label;
    /// 正在等用户按一个键。
    in property <bool> rebinding: false;

    // ---- 麦克风 ----
    /// 麦克风电平，已经从分贝映射成 0–1。
    in property <float> input-level;
    /// 语音激活的阈值，同一把尺子。
    in-out property <float> vad-level;
    /// 现在在不在往外发。
    in property <bool> transmitting: false;
    in property <bool> monitoring: false;
    /// 设备下拉框的内容，第 0 项永远是「系统默认」。
    in property <[string]> capture-devices;
    in property <[string]> render-devices;
    in-out property <int> capture-index: 0;
    in-out property <int> render-index: 0;
    /// 实际打开的那个采集设备叫什么。可能跟选的不一样（选的那个没了）。
    in property <string> capture-in-use;
    /// 实际用的是不是虚拟声卡。是的话要提醒 —— 没在路由的虚拟麦是纯静音的。
    in property <bool> capture-is-virtual: false;
    /// 正在挨个试麦克风。
    in property <bool> scanning: false;
    in property <[ScanRow]> scan-results;

    // ---- 回调 ----
    callback join();
    callback leave();
    callback join-channel(int);
    callback send-text();
    callback toggle-mute();
    callback toggle-deafen();
    callback toggle-settings();
    callback set-ptt-mode(bool);
    callback rebind-ptt();
    callback cancel-rebind();
    callback toggle-monitor();
    callback set-vad(float);
    callback pick-capture(int);
    callback pick-render(int);
    callback scan-microphones();
    callback pick-capture-id(string);

    // =======================================================================
    // 没连上：一个框，一个按钮
    // =======================================================================
    if !root.connected && !root.show-settings: VerticalLayout {
        alignment: center;
        padding: 48px;

        VerticalLayout {
            spacing: 18px;
            max-width: 460px;
            alignment: center;

            Text {
                text: "开麦";
                color: Theme.text;
                font-size: 30px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: "把朋友发给你的那条链接粘进来";
                color: Theme.dim;
                font-size: 14px;
                horizontal-alignment: center;
            }

            VerticalLayout {
                spacing: 10px;
                link := Field {
                    placeholder: "kaimai://j/…";
                    text <=> root.invite-link;
                    accepted => { root.join(); }
                }
                Field {
                    placeholder: "你的昵称";
                    text <=> root.nick;
                    accepted => { root.join(); }
                }
                Btn {
                    label: root.connecting ? "正在连接…" : "加入";
                    primary: true;
                    enabled: !root.connecting && root.invite-link != "";
                    clicked => { root.join(); }
                }
            }

            // 报错要占住位置一起显示，别用弹窗 —— 弹窗一关，用户就想不起来
            // 刚才说了什么，而这几行恰恰是要照着做的。
            if root.error-headline != "": Rectangle {
                background: #2a1d1d;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #4a2b28;

                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    Text {
                        text: root.error-headline;
                        color: Theme.danger;
                        font-size: 14px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.error-advice;
                        color: Theme.dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }

            // 连不上的时候最想确认的就是「是不是我麦克风的问题」，
            // 所以这个入口必须在登录页上就有。
            Btn {
                label: "先试试麦克风";
                clicked => { root.toggle-settings(); }
            }

            if root.my-fingerprint != "": Text {
                text: "你的身份指纹 " + root.my-fingerprint;
                color: Theme.faint;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }
    }

    // =======================================================================
    // 连上了：左边频道树，右边文字
    // =======================================================================
    if root.connected && !root.show-settings: HorizontalLayout {
        spacing: 0;

        // ---- 左：频道树 + 成员 ----
        Rectangle {
            width: 260px;
            background: Theme.panel;

            VerticalLayout {
                padding: 0;

                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: Theme.pad;
                        padding-right: Theme.pad;
                        spacing: 8px;
                        Text {
                            text: root.server-name;
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Btn {
                            width: 34px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            label: "⚙";
                            clicked => { root.toggle-settings(); }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }


                ScrollView {
                    VerticalLayout {
                        padding: 6px;
                        spacing: 1px;

                        for row[i] in root.rows: Rectangle {
                            height: row.is-channel ? 30px : 28px;
                            border-radius: 6px;
                            background: row.is-channel && row.is-current
                                ? Theme.raised
                                : (rowtouch.has-hover && row.is-channel ? Theme.hover : transparent);
                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 8px + (row.depth * 12px);
                                padding-right: 10px;
                                spacing: 8px;

                                if !row.is-channel: Dot {
                                    y: (parent.height - self.height) / 2;
                                    // 正在说话压过静音状态：一个人可能自己没闭麦
                                    // 但别人也没听见，那种时候「他在说话」更有用。
                                    tint: row.speaking
                                        ? Theme.speaking
                                        : (row.deafened
                                            ? Theme.danger
                                            : (row.muted ? Theme.warn : Theme.faint));
                                    // 说话时那个点要看得出来在动
                                    width: row.speaking ? 10px : 8px;
                                    height: self.width;
                                    border-radius: self.width / 2;
                                    animate width { duration: 100ms; }
                                }

                                Text {
                                    text: row.is-channel ? row.name : "  " + row.name;
                                    color: row.is-channel
                                        ? (row.is-current ? Theme.text : Theme.dim)
                                        : (row.is-me ? Theme.accent : Theme.text);
                                    font-size: row.is-channel ? 13px : 14px;
                                    font-weight: row.is-channel ? 600 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                if row.is-channel: Text {
                                    text: row.count > 0 ? row.count : "";
                                    color: Theme.faint;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            rowtouch := TouchArea {
                                enabled: row.is-channel;
                                mouse-cursor: row.is-channel ? pointer : default;
                                clicked => { root.join-channel(row.id); }
                            }
                        }
                    }
                }

                // ---- 自己的那一条，钉在底部 ----
                Rectangle { height: 1px; background: Theme.line; }
                Rectangle {
                    height: 56px;
                    background: Theme.bg;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: root.nick;
                                color: Theme.text;
                                font-size: 13px;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                Dot {
                                    y: 4px;
                                    tint: root.udp-ok ? Theme.speaking : Theme.warn;
                                }
                                Text {
                                    text: root.voice-error != ""
                                        ? "语音出错"
                                        : (!root.udp-ok
                                            ? "语音连接中…"
                                            : (root.ptt-mode
                                                ? (root.ptt-label == ""
                                                    ? "没绑说话键"
                                                    : "按住 " + root.ptt-label + " 说话")
                                                : "语音激活"));
                                    color: root.voice-error != "" ? Theme.danger : Theme.faint;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                        }

                        Btn {
                            width: 44px;
                            y: (parent.height - self.height) / 2;
                            label: root.self-muted ? "🔇" : "🎤";
                            clicked => { root.toggle-mute(); }
                        }
                        Btn {
                            width: 44px;
                            y: (parent.height - self.height) / 2;
                            label: root.self-deafened ? "🔕" : "🔊";
                            clicked => { root.toggle-deafen(); }
                        }
                    }
                }
            }
        }

        Rectangle { width: 1px; background: Theme.line; }

        // ---- 右：文字 ----
        Rectangle {
            background: Theme.bg;
            horizontal-stretch: 1;

            VerticalLayout {
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: Theme.pad;
                        padding-right: Theme.pad;
                        spacing: 8px;
                        Text {
                            text: "频道文字";
                            color: Theme.dim;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Btn {
                            width: 72px;
                            y: (parent.height - self.height) / 2;
                            label: "离开";
                            clicked => { root.leave(); }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }

                // 语音出错要占住位置一起显示。麦克风没声音的时候，用户第一件
                // 想知道的就是「为什么」，而弹窗一关就没了。
                if root.voice-error != "": Rectangle {
                    background: #2a1d1d;
                    VerticalLayout {
                        padding: 12px;
                        Text {
                            text: root.voice-error;
                            color: Theme.danger;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: 10px;
                        alignment: start;

                        if root.chat.length == 0: Text {
                            text: "这里的消息关掉就没了 —— 发个链接、报个坐标用的，不留记录。";
                            color: Theme.faint;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        for line[i] in root.chat: VerticalLayout {
                            spacing: 3px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: line.sender;
                                    color: line.is-me ? Theme.accent : Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: line.time;
                                    color: Theme.faint;
                                    font-size: 11px;
                                    vertical-alignment: bottom;
                                }
                            }
                            Text {
                                text: line.body;
                                color: Theme.text;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 60px;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Field {
                            placeholder: "说点什么";
                            text <=> root.draft;
                            horizontal-stretch: 1;
                            accepted => { root.send-text(); }
                        }
                        Btn {
                            width: 64px;
                            label: "发送";
                            primary: true;
                            enabled: root.draft != "";
                            clicked => { root.send-text(); }
                        }
                    }
                }
            }
        }
    }
    // =======================================================================
    // 设置。**连不连服务器都能开** —— 「我的麦克风好不好使」这个问题，
    // 恰恰在连不上的时候最想知道：是我麦克风坏了，还是服务器的问题？
    // =======================================================================
    if root.show-settings: VerticalLayout {
        Rectangle {
            height: 52px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                spacing: 8px;
                Btn {
                    width: 40px;
                    y: (parent.height - self.height) / 2;
                    label: "←";
                    clicked => { root.toggle-settings(); }
                }
                Text {
                    text: "设置";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        ScrollView {
            vertical-stretch: 1;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    // 设备名字很长，260px 的侧栏里挤得没法看。
                    width: 460px;
                VerticalLayout {
                    padding: Theme.pad;
                    spacing: 14px;
                    alignment: start;

                    Text {
                        text: "说话方式";
                        color: Theme.dim;
                        font-size: 12px;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Btn {
                            label: "语音激活";
                            primary: !root.ptt-mode;
                            clicked => { root.set-ptt-mode(false); }
                        }
                        Btn {
                            label: "按住说话";
                            primary: root.ptt-mode;
                            clicked => { root.set-ptt-mode(true); }
                        }
                    }

                    Text {
                        text: "按住说话的键";
                        color: Theme.dim;
                        font-size: 12px;
                    }
                    Btn {
                        label: root.rebinding
                            ? "按一个键…（点这里取消）"
                            : (root.ptt-label == "" ? "还没设置，点这里设" : root.ptt-label);
                        primary: root.rebinding;
                        clicked => {
                            if (root.rebinding) { root.cancel-rebind(); }
                            else { root.rebind-ptt(); }
                        }
                    }
                    Text {
                        text: "键盘任意键，或者鼠标侧键。游戏全屏时也有效，"
                            + "而且不会把这个键从游戏那边抢走。";
                        color: Theme.faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    Rectangle { height: 1px; background: Theme.line; }

                    // 设备出的错要**在这一页就看得见**。
                    //
                    // 第一版只在「已连接」那个界面里渲染它，于是设置页上设备打不开时
                    // 用户只看到一个闪一下就灭的麦克风灯，而原因明明已经拿到了。
                    if root.voice-error != "": Rectangle {
                        background: #2a1d1d;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: #4a2b28;
                        VerticalLayout {
                            padding: 12px;
                            Text {
                                text: root.voice-error;
                                color: Theme.danger;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Text {
                        text: "麦克风";
                        color: Theme.dim;
                        font-size: 12px;
                    }
                    ComboBox {
                        model: root.capture-devices;
                        current-index <=> root.capture-index;
                        selected(v) => { root.pick-capture(root.capture-index); }
                    }
                    // **始终显示现在真正打开的是哪个设备。**
                    //
                    // 「系统默认」到底是哪一个，用户是不知道的；而麦克风灯亮不亮、
                    // 是哪个设备的灯在亮，是他唯一的旁证。这一行把那个旁证坐实。
                    Text {
                        text: root.capture-in-use == ""
                            ? "正在打开设备…"
                            : "正在用：" + root.capture-in-use;
                        color: Theme.faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    // 玩家机器上默认麦克风经常是 Sonar / Synapse 这类虚拟设备，
                    // 而它们没在路由的时候是纯静音的。必须说出来。
                    if root.capture-is-virtual: Text {
                        text: "这是个虚拟声卡。这类设备没在路由的时候是纯静音的，"
                            + "条子不动就换一个带「麦克风」字样的真设备试试。";
                        color: Theme.warn;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    LevelBar {
                        level: root.input-level;
                        threshold: root.vad-level;
                        active: root.transmitting;
                        show-threshold: !root.ptt-mode;
                    }
                    Text {
                        text: root.input-level < 0.02
                            ? "没收到声音。说句话看看条子动不动。"
                            : (root.ptt-mode
                                ? "按住说话键时才会发出去。"
                                : (root.transmitting
                                    ? "正在发送。"
                                    : "有声音，但没过竖线那道坎，所以没发出去。"));
                        color: root.input-level >= 0.02 && !root.transmitting && !root.ptt-mode
                            ? Theme.warn
                            : Theme.faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    // 一键把每个麦克风都试一遍。用户对着一个下拉框是猜不出来哪个能用的，
                    // 而程序挨个试只要几秒。
                    Btn {
                        label: root.scanning
                            ? "正在挨个试…一直说话别停"
                            : "挨个试一遍，找出哪个麦克风能用";
                        primary: root.scanning;
                        enabled: !root.scanning;
                        clicked => { root.scan-microphones(); }
                    }

                    if root.scan-results.length > 0: VerticalLayout {
                        spacing: 4px;
                        for row[i] in root.scan-results: Rectangle {
                            height: 42px;
                            border-radius: 6px;
                            background: scantouch.has-hover ? Theme.hover : Theme.raised;
                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Dot {
                                    y: (parent.height - self.height) / 2;
                                    tint: row.ok ? Theme.speaking : Theme.faint;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: row.name;
                                        color: row.ok ? Theme.text : Theme.dim;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.verdict;
                                        color: row.ok ? Theme.speaking : Theme.faint;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                            }
                            scantouch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.pick-capture-id(row.id); }
                            }
                        }
                        Text {
                            text: "点一行就选中那个设备。绿点表示检测时真的收到了人声。";
                            color: Theme.faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }

                    // 条子一直不动的三个常见原因，按从常见到不常见排。
                    // 第三条最坑：Windows 的隐私设置挡掉麦克风时，
                    // 应用拿到的是**静音**而不是报错，看起来跟设备坏了一模一样。
                    if root.input-level < 0.02: Text {
                        text: "一直不动的话：换上面那个下拉框里别的设备试试；"
                            + "检查 Windows 音量合成器里这个麦克风有没有被静音；"
                            + "再看看「设置 → 隐私和安全性 → 麦克风」里有没有允许桌面应用访问 —— "
                            + "被挡住的时候拿到的是静音，跟设备坏了看起来一模一样。";
                        color: Theme.faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    if !root.ptt-mode: VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "语音激活的灵敏度";
                            color: Theme.faint;
                            font-size: 11px;
                        }
                        Slider {
                            minimum: 0;
                            maximum: 1;
                            value <=> root.vad-level;
                            changed(v) => { root.set-vad(v); }
                        }
                        Text {
                            text: "往左更灵敏（轻声也发），往右更迟钝（键盘声不会发出去）。";
                            color: Theme.faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }

                    Text {
                        text: "耳机 / 扬声器";
                        color: Theme.dim;
                        font-size: 12px;
                    }
                    ComboBox {
                        model: root.render-devices;
                        current-index <=> root.render-index;
                        selected(v) => { root.pick-render(root.render-index); }
                    }

                    Btn {
                        label: root.monitoring ? "停止试听" : "试听自己的麦";
                        primary: root.monitoring;
                        clicked => { root.toggle-monitor(); }
                    }
                    if root.monitoring: Rectangle {
                        background: #2a2417;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 10px;
                            Text {
                                text: "用扬声器试听会啸叫，戴耳机。听到的是直接回放，"
                                    + "别人听到的还会多过一道压缩。";
                                color: Theme.warn;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // 选了按住说话却没绑键 = 一个字都发不出去。必须说出来。
                    if root.ptt-mode && root.ptt-label == "": Rectangle {
                        background: #2a2417;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 10px;
                            Text {
                                text: "还没绑键，现在谁都听不见你说话。";
                                color: Theme.warn;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                }
            }
        }
    }
}
